<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <!-- Estilo Android Auto: barra lateral à esquerda + cartões arredondados -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Barra lateral -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnChannel"
                style="@style/DockButton"
                android:contentDescription="Escolher câmera">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_swap" />

                <TextView
                android:id="@+id/lblChannel"
                    style="@style/DockLabel"
                    android:text="Câmeras" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnReload"
                style="@style/DockButton"
                android:contentDescription="Reconectar">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_refresh" />

                <TextView
                    style="@style/DockLabel"
                    android:text="Reconectar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFullscreen"
                style="@style/DockButton"
                android:contentDescription="Tela cheia">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_fullscreen" />

                <TextView
                    style="@style/DockLabel"
                    android:text="Tela cheia" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnRoad"
                style="@style/DockButton"
                android:contentDescription="Simulação da estrada">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_road" />

                <TextView
                    android:id="@+id/lblRoad"
                    style="@style/DockLabel"
                    android:text="Estrada" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAuto"
                style="@style/DockButton"
                android:contentDescription="Android Auto">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_car" />

                <TextView
                    style="@style/DockLabel"
                    android:text="Android Auto" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDiag"
                style="@style/DockButton"
                android:contentDescription="Diagnóstico">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_info" />

                <TextView
                    style="@style/DockLabel"
                    android:text="Diagnóstico" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnUpdate"
                style="@style/DockButton"
                android:contentDescription="Verificar atualização">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_download" />

                <TextView
                android:id="@+id/lblUpdate"
                    style="@style/DockLabel"
                    android:text="Atualizar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                style="@style/DockButton"
                android:contentDescription="Ajustes">

                <ImageView
                    style="@style/DockIcon"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/DockLabel"
                    android:text="Ajustes" />
            </LinearLayout>

            <TextClock
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Cartão do vídeo principal -->
        <FrameLayout
            android:id="@+id/videoCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_video"
            android:clipToOutline="true">

            <TextureView
                android:id="@+id/textureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <!-- Estrada 3D noturna (Filament); o RoadView desenha o painel por cima -->
            <com.dashlive.app.Road3DView
                android:id="@+id/road3d"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.dashlive.app.RoadView
                android:id="@+id/roadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Aviso de colisão (FCW) sobre a Estrada; fora da Estrada o aviso é só sonoro -->
            <com.dashlive.app.adas.AdasOverlayView
                android:id="@+id/adasOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxWidth="420dp"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/livePill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="AO VIVO"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/mainLabel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Frontal"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnExitFs"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="Sair da tela cheia"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Coluna da direita: câmera traseira + estado -->
        <LinearLayout
            android:id="@+id/sidePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/rearCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:visibility="gone"
                android:background="@drawable/bg_video"
                android:clickable="true"
                android:clipToOutline="true"
                android:contentDescription="Tocar para trazer esta câmera para a tela grande"
                android:focusable="true">

                <TextureView
                    android:id="@+id/rearTexture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/rearOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Conectando…"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/rearLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Traseira"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_warn_dot" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Conectando"
                        android:textColor="@color/text"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView style="@style/InfoLabel" android:text="Endereço" />

                        <TextView
                            android:id="@+id/valIp"
                            style="@style/InfoValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView style="@style/InfoLabel" android:text="Câmera principal" />

                        <TextView
                            android:id="@+id/valChannel"
                            style="@style/InfoValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView style="@style/InfoLabel" android:text="Motor de vídeo" />

                        <TextView
                            android:id="@+id/valProto"
                            style="@style/InfoValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView style="@style/InfoLabel" android:text="Versão do app" />

                        <TextView
                            android:id="@+id/valVersion"
                            style="@style/InfoValue" />
                    </LinearLayout>

            </LinearLayout>

            <!-- Carro (OBD2): toque para escolher o adaptador -->
            <LinearLayout
                android:id="@+id/carCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Carro (OBD2)"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/carDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_warn_dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Carro (OBD2)"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/carVolts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/carStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Toque para escolher o adaptador"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/carValues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout style="@style/CarCell">
                        <TextView android:id="@+id/carSpeed" style="@style/CarValue" />
                        <TextView style="@style/CarUnit" android:text="km/h" />
                    </LinearLayout>

                    <LinearLayout style="@style/CarCell">
                        <TextView android:id="@+id/carRpm" style="@style/CarValue" />
                        <TextView style="@style/CarUnit" android:text="rpm" />
                    </LinearLayout>

                    <LinearLayout style="@style/CarCell">
                        <TextView android:id="@+id/carTemp" style="@style/CarValue" />
                        <TextView style="@style/CarUnit" android:text="°C motor" />
                    </LinearLayout>

                    <LinearLayout style="@style/CarCell">
                        <TextView android:id="@+id/carFuel" style="@style/CarValue" />
                        <TextView style="@style/CarUnit" android:text="% tanque" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Setas e faróis (Ford Ka: mensagens 0x3B3/0x3C3); apagados = 15% -->
                <LinearLayout
                    android:id="@+id/carLights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/carTurnLeft"
                        style="@style/CarLight"
                        android:src="@drawable/ic_turn_left"
                        android:tint="@color/light_turn" />

                    <ImageView
                        android:id="@+id/carLowBeam"
                        style="@style/CarLight"
                        android:src="@drawable/ic_beam_low"
                        android:tint="@color/light_turn" />

                    <ImageView
                        android:id="@+id/carHighBeam"
                        style="@style/CarLight"
                        android:src="@drawable/ic_beam_high"
                        android:tint="@color/light_high" />

                    <ImageView
                        android:id="@+id/carTurnRight"
                        style="@style/CarLight"
                        android:src="@drawable/ic_turn_right"
                        android:tint="@color/light_turn" />
                </LinearLayout>
            </LinearLayout>

            <!-- Aviso de atualização -->
            <LinearLayout
                android:id="@+id/updateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/updateNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/updateProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btnUpdateNow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_download"
                        android:tint="@color/on_primary" />

                    <TextView
                        android:id="@+id/btnUpdateNowText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Baixar e instalar"
                        android:textColor="@color/on_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
